# No PIN, token, or database contents belong in the repository.
LED_PUBLIC_ORIGIN=https://planner.your-domain.example
LED_DATABASE=/data/ledplanner.sqlite
# WhatsApp business number, international format without + or spaces. Leave blank until set.
LED_WHATSAPP=
# Secure cookies are the default. Only use LED_DEV_HTTP=1 for localhost testing.
# LED_DEV_HTTP=1
# Exact IP of the one trusted reverse proxy; never * on a publicly reachable server.
# LED_TRUSTED_PROXY=172.18.0.2
