{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LED Planner",
  "version": "1.0.1",
  "identifier": "com.hdrgcreativepartner.ledplanner",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LED Planner",
        "url": "https://hdrgcreativepartner-del.github.io/LEDPlanner/",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "LED mapping and cabling planner",
    "longDescription": "Desktop shell for LED Planner by HDRG Creative Partner."
  }
}
